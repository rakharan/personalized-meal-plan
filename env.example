# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Base URL of your local OpenAI-compatible server (llama.cpp server / text-generation-webui)
LLM_BASE_URL=http://localhost:20128/v1

# Model name your server expects in the request body.
LLM_MODEL=prod/auto

# Optional: only needed if your server enforces an API key
LLM_API_KEY=not-needed

# LLM retry settings
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_MS=2000

# Optional: fallback model if primary fails all retries
# LLM_FALLBACK_MODEL=prod/mistral-large-3-675b-instruct

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5433
PG_USER=mealplan
PG_PASSWORD=your_password
PG_DATABASE=mealplan

# Daily push defaults (used when user hasn't set custom time)
DAILY_PUSH_HOUR=8
DAILY_PUSH_MIN=0

# Admin dashboard
ADMIN_TOKEN=changeme_admin_2026
DASHBOARD_PORT=3000

# Optional: Email delivery (SMTP) — uncomment + set to enable
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Meal Plan Bot <your_email@gmail.com>"

# Optional: WhatsApp Business API — uncomment + set to enable
# WHATSAPP_TOKEN=your_whatsapp_token
# WHATSAPP_PHONE_ID=your_phone_number_id
# WHATSAPP_API_VERSION=v20.0
