{
  "$schema": "https://design-tokens.github.io/community-group/design-tokens/",
  "name": "Saji Design System",
  "version": "1.0.0",
  "description": "Warm Kitchen brand tokens for Saji — Indonesian daily meal plan assistant",

  "primitive": {
    "color": {
      "brown": {
        "900": { "value": "#1A1612", "description": "Dark espresso, charred clay" },
        "800": { "value": "#241F1B", "description": "Roasted coffee" },
        "700": { "value": "#2D2823", "description": "Cocoa" },
        "600": { "value": "#3A342E", "description": "Cinnamon bark" }
      },
      "cream": {
        "100": { "value": "#E8E0D5", "description": "Coconut cream" },
        "200": { "value": "#C4B8A8", "description": "Sand" },
        "300": { "value": "#8A7E72", "description": "Driftwood" },
        "400": { "value": "#5C5248", "description": "Charred wood" }
      },
      "leaf": {
        "400": { "value": "#74C69D", "description": "Mint, young shoot" },
        "500": { "value": "#52B788", "description": "Kangkung, fresh herbs" },
        "600": { "value": "#2D6A4F", "description": "Bay leaf, deep green" }
      },
      "amber": {
        "400": { "value": "#FCD34D", "description": "Honey, madu" },
        "500": { "value": "#F59E0B", "description": "Turmeric, kunyit" },
        "600": { "value": "#D97706", "description": "Palm sugar, gula merah" }
      },
      "tomato": {
        "500": { "value": "#E5484D", "description": "Cabai, chili pepper" },
        "600": { "value": "#C62828", "description": "Sambal deep" }
      },
      "white": { "value": "#FFFFFF" },
      "black": { "value": "#000000" }
    },

    "font": {
      "family": {
        "sans": { "value": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "description": "Primary UI font — Indonesian type foundry" },
        "mono": { "value": "'JetBrains Mono', 'SF Mono', 'Cascadia Code', Consolas, monospace", "description": "Data/code/numeric" }
      },
      "weight": {
        "light": { "value": 300 },
        "regular": { "value": 400 },
        "medium": { "value": 500 },
        "semibold": { "value": 600 },
        "bold": { "value": 700 }
      },
      "size": {
        "xs": { "value": "0.75rem", "px": 12 },
        "sm": { "value": "0.875rem", "px": 14 },
        "md": { "value": "1rem", "px": 16 },
        "lg": { "value": "1.25rem", "px": 20 },
        "xl": { "value": "1.5rem", "px": 24 },
        "2xl": { "value": "2rem", "px": 32 },
        "3xl": { "value": "2.5rem", "px": 40 }
      },
      "lineHeight": {
        "tight": { "value": 1.2 },
        "normal": { "value": 1.5 },
        "relaxed": { "value": 1.7 }
      },
      "letterSpacing": {
        "tight": { "value": "-0.03em" },
        "snug": { "value": "-0.02em" },
        "normal": { "value": "0" },
        "wide": { "value": "0.05em" }
      }
    },

    "space": {
      "0": { "value": 0 },
      "1": { "value": "4px" },
      "2": { "value": "8px" },
      "3": { "value": "12px" },
      "4": { "value": "16px" },
      "5": { "value": "20px" },
      "6": { "value": "24px" },
      "8": { "value": "32px" },
      "10": { "value": "40px" },
      "12": { "value": "48px" }
    },

    "radius": {
      "none": { "value": 0 },
      "sm": { "value": "6px" },
      "md": { "value": "8px" },
      "lg": { "value": "12px" },
      "xl": { "value": "16px" },
      "pill": { "value": "9999px" }
    },

    "shadow": {
      "elevation-0": { "value": "none", "description": "Flat, border only" },
      "elevation-1": { "value": "0 0 0 1px var(--border)", "description": "Border ring" },
      "elevation-2": { "value": "0 0 0 1px var(--border-strong), 0 4px 12px rgba(0,0,0,0.3)", "description": "Card hover" },
      "elevation-3": { "value": "0 0 0 1px var(--border-strong), 0 8px 24px rgba(0,0,0,0.4)", "description": "Modal overlay" }
    },

    "motion": {
      "duration": {
        "instant": { "value": "0ms" },
        "micro": { "value": "150ms" },
        "small": { "value": "200ms" },
        "large": { "value": "300ms" }
      },
      "easing": {
        "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "description": "Ease-out standard" }
      }
    },

    "grid": {
      "columns": { "value": 12 },
      "maxWidth": { "value": "1200px" },
      "gutter": { "value": "40px" }
    }
  },

  "semantic": {
    "color": {
      "dark": {
        "bg": { "value": "{primitive.color.brown.900.value}" },
        "surface": { "value": "{primitive.color.brown.800.value}" },
        "surface-2": { "value": "{primitive.color.brown.700.value}" },
        "surface-3": { "value": "{primitive.color.brown.600.value}" },
        "text": { "value": "{primitive.color.cream.100.value}" },
        "text-muted": { "value": "{primitive.color.cream.200.value}" },
        "text-subtle": { "value": "{primitive.color.cream.300.value}" },
        "text-faint": { "value": "{primitive.color.cream.400.value}" },
        "primary": { "value": "{primitive.color.leaf.500.value}" },
        "primary-hover": { "value": "{primitive.color.leaf.400.value}" },
        "accent": { "value": "{primitive.color.amber.500.value}" },
        "accent-soft": { "value": "rgba(245,158,11,0.10)" },
        "primary-soft": { "value": "rgba(82,183,136,0.12)" },
        "danger": { "value": "{primitive.color.tomato.500.value}" },
        "success": { "value": "{primitive.color.leaf.500.value}" },
        "border": { "value": "rgba(255,255,255,0.06)" },
        "border-strong": { "value": "rgba(255,255,255,0.09)" }
      },
      "light": {
        "bg": { "value": "#FDF8F3", "description": "Warm cream" },
        "surface": { "value": "{primitive.color.white.value}" },
        "surface-2": { "value": "#F5F0E8", "description": "Warm off-white" },
        "surface-3": { "value": "#EDE5D8", "description": "Warm sand" },
        "text": { "value": "{primitive.color.brown.900.value}" },
        "text-muted": { "value": "#4A4540" },
        "text-subtle": { "value": "#7A7268" },
        "text-faint": { "value": "#A09890" },
        "primary": { "value": "{primitive.color.leaf.600.value}" },
        "primary-hover": { "value": "{primitive.color.leaf.500.value}" },
        "accent": { "value": "#E07856", "description": "Warm terracotta accent" },
        "accent-soft": { "value": "rgba(224,120,86,0.10)" },
        "primary-soft": { "value": "rgba(45,106,79,0.08)" },
        "danger": { "value": "{primitive.color.tomato.600.value}" },
        "success": { "value": "{primitive.color.leaf.600.value}" },
        "border": { "value": "rgba(0,0,0,0.07)" },
        "border-strong": { "value": "rgba(0,0,0,0.10)" }
      }
    },
    "font": {
      "display": { "value": "{primitive.font.family.sans.value}", "weight": "{primitive.font.weight.bold.value}", "size": "{primitive.font.size.2xl.value}", "letterSpacing": "{primitive.font.letterSpacing.tight.value}" },
      "h1": { "value": "{primitive.font.family.sans.value}", "weight": "{primitive.font.weight.semibold.value}", "size": "{primitive.font.size.xl.value}", "letterSpacing": "{primitive.font.letterSpacing.snug.value}" },
      "h2": { "value": "{primitive.font.family.sans.value}", "weight": "{primitive.font.weight.semibold.value}", "size": "{primitive.font.size.lg.value}", "letterSpacing": "{primitive.font.letterSpacing.normal.value}" },
      "h3": { "value": "{primitive.font.family.sans.value}", "weight": "{primitive.font.weight.semibold.value}", "size": "{primitive.font.size.xs.value}", "letterSpacing": "{primitive.font.letterSpacing.wide.value}", "transform": "uppercase" },
      "body": { "value": "{primitive.font.family.sans.value}", "weight": "{primitive.font.weight.regular.value}", "size": "{primitive.font.size.sm.value}" },
      "small": { "value": "{primitive.font.family.sans.value}", "weight": "{primitive.font.weight.regular.value}", "size": "{primitive.font.size.xs.value}" },
      "tabular": { "value": "{primitive.font.family.sans.value}", "variant": "tabular-nums" }
    }
  },

  "component": {
    "button": {
      "paddingX": { "value": "{primitive.space.4.value}" },
      "paddingY": { "value": "{primitive.space.2.value}" },
      "fontSize": { "value": "{primitive.font.size.sm.value}" },
      "fontWeight": { "value": "{primitive.font.weight.medium.value}" },
      "radius": { "value": "{primitive.radius.sm.value}" },
      "border": { "value": "none" },
      "cursor": { "value": "pointer" }
    },
    "statCard": {
      "paddingX": { "value": "{primitive.space.5.value}" },
      "paddingY": { "value": "{primitive.space.4.value}" },
      "radius": { "value": "{primitive.radius.md.value}" },
      "shadow": { "value": "{primitive.shadow.elevation-1.value}" },
      "hoverShadow": { "value": "{primitive.shadow.elevation-2.value}" },
      "numberSize": { "value": "{primitive.font.size.2xl.value}" },
      "numberWeight": { "value": "{primitive.font.weight.semibold.value}" },
      "labelSize": { "value": "{primitive.font.size.xs.value}" },
      "labelColor": { "value": "{semantic.color.dark.text-subtle.value}" }
    },
    "table": {
      "cellPaddingX": { "value": "{primitive.space.4.value}" },
      "cellPaddingY": { "value": "{primitive.space.2.value}" },
      "headerBg": { "value": "{semantic.color.dark.surface-2.value}" },
      "headerColor": { "value": "{semantic.color.dark.text-subtle.value}" },
      "headerSize": { "value": "{primitive.font.size.xs.value}" },
      "cellSize": { "value": "{primitive.font.size.sm.value}" },
      "hoverBg": { "value": "{semantic.color.dark.surface-2.value}" }
    },
    "input": {
      "paddingX": { "value": "{primitive.space.3.value}" },
      "paddingY": { "value": "{primitive.space.2.value}" },
      "radius": { "value": "{primitive.radius.sm.value}" },
      "bg": { "value": "{semantic.color.dark.surface-2.value}" },
      "borderColor": { "value": "{semantic.color.dark.border.value}" },
      "focusBorderColor": { "value": "{semantic.color.dark.primary.value}" },
      "fontSize": { "value": "{primitive.font.size.sm.value}" }
    },
    "sidebar": {
      "width": { "value": "220px" },
      "bg": { "value": "{semantic.color.dark.surface.value}" },
      "navItemPaddingX": { "value": "{primitive.space.5.value}" },
      "navItemPaddingY": { "value": "{primitive.space.2.value}" },
      "navItemColor": { "value": "{semantic.color.dark.text-subtle.value}" },
      "navItemActiveColor": { "value": "{semantic.color.dark.text.value}" },
      "navItemActiveBg": { "value": "{semantic.color.dark.primary-soft.value}" },
      "navItemActiveBorder": { "value": "{semantic.color.dark.primary.value}" }
    }
  }
}
